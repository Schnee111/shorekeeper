# Shorekeeper — environment variables (copy ke .env, isi manual, JANGAN commit .env)
# Semua nilai di sini placeholder. Hard rule: tidak ada secret nyata di repo.

# --- Model / worker (oh-my-pi) ---
OMP_MODELS_YML=~/.omp/agent/models.yml
# Provider free via 9router (lihat models.yml): opencode/deepseek-v4-flash-free

# --- Data & artifacts ---
DATA_DIR=./data
TASKS_DB=./data/tasks.db

# --- Orchestrator ---
HERMES_WS_PORT=9119
APPROVAL_PUSH_MAIN=false

# --- Observability (FASE 3) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- LiveKit Cloud (free tier, fase voice) ---
LIVEKIT_URL=wss://YOUR-INSTANCE.livekit.cloud
LIVEKIT_KEY=devkey-placeholder
LIVEKIT_SECRET=devsecret-placeholder
# GEMINI_API_KEY= (diisi manual, never commit — dipakai front live)